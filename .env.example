# Copiez ce fichier en .env si vous lancez le serveur à la main (facultatif).
# Port d'écoute (sur Pterodactyl, SERVER_PORT est fourni automatiquement).
PORT=3000
# Adresse d'écoute (0.0.0.0 = accessible depuis le réseau local).
HOST=0.0.0.0
# Dossier des notes. Chemin relatif au dossier de lancement, ou absolu.
VAULT_DIR=./vault
