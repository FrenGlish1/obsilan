{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ObsiLan",
  "version": "0.4.0",
  "identifier": "fr.obsilan.app",
  "build": {
    "frontendDist": "../dist/public",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:client",
    "beforeBuildCommand": "npm run build:client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ObsiLan",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser"
      }
    }
  }
}
