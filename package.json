{
  "name": "obsilan",
  "version": "0.4.0",
  "private": true,
  "description": "Prise de notes Markdown auto-hébergée, compatible Obsidian",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "concurrently -k -n serveur,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "node server/build.mjs",
    "start": "node dist/server.mjs",
    "check": "tsc -p server/tsconfig.json && svelte-check --tsconfig client/tsconfig.json",
    "test": "vitest run",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "android:build": "tauri android build --apk --target aarch64",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fastify/static": "^10.1.6",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@types/node": "^26.6.5",
    "acme-client": "^5.4.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.7",
    "marked": "^18.1.1",
    "minisearch": "^7.2.0",
    "node-diff3": "^3.2.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
